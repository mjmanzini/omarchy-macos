#!/bin/bash
# Keep GTK apps, the cursor, the UI font and the dock in step with the theme.
#
# Omarchy themes only carry an icon theme; GTK theme, cursor, UI font and the
# dock's stylesheet are not themed by anything. This hook does that, so
# switching between macos-light and macos-dark changes app chrome and the dock
# too, not just the palette.
#
# The macos-* themes get the WhiteSur/Apple treatment and ironman gets its own.
# Every other theme -- Omarchy's stock ones included -- gets Adwaita matched to
# whether the theme is light or dark, plus the same pointer and UI font as the
# rest of the system.
#
# Reverting the pointer and font for stock themes, which this hook used to do,
# made them worse rather than neutral: the window chrome (title bars, dock,
# rounding, blur) lives in looknfeel.lua and applies to every theme, so a stock
# theme ended up with Mac chrome, an Adwaita pointer and an Adwaita font at
# once. Keeping those two constant means switching theme changes the colours
# and nothing else. ./uninstall.sh is what puts the fully stock look back.

THEME="$1"
gs() { gsettings set org.gnome.desktop.interface "$@" 2>/dev/null; }

# Every Omarchy theme declares mode = "light" or "dark" in its colors.toml.
# Checked by name in both theme locations, then the applied-theme state dir as
# a fallback, so this works for user themes and stock ones alike.
theme_mode() {
  local candidate mode
  for candidate in \
    "$HOME/.config/omarchy/themes/$1/colors.toml" \
    "${OMARCHY_PATH:-/usr/share/omarchy}/themes/$1/colors.toml" \
    "$HOME/.local/state/omarchy/current/theme/colors.toml"; do
    [ -f "$candidate" ] || continue
    mode=$(sed -n 's/^[[:space:]]*mode[[:space:]]*=[[:space:]]*"\([a-z]*\)".*/\1/p' "$candidate" | head -1)
    if [ -n "$mode" ]; then echo "$mode"; return; fi
  done
  # Omarchy's themes are predominantly dark, so that is the safer guess.
  echo dark
}

DOCK_CFG="$HOME/.config/nwg-dock-hyprland"
DOCK_CMD="nwg-dock-hyprland -d -i 40 -p bottom -a center -mb 10 -c omarchy-menu -lp start"
DOCK_PROC="nwg-dock-hyprla" # /proc comm is capped at 15 chars

apply_dock_style() {
  local variant="$1"
  [ -f "$DOCK_CFG/style-$variant.css" ] || return 0
  cp "$DOCK_CFG/style-$variant.css" "$DOCK_CFG/style.css"
  # nwg-dock reads its CSS only at startup, so restyling means restarting it.
  # Only restart a dock that is actually running.
  if pgrep -x "$DOCK_PROC" >/dev/null 2>&1; then
    pkill -x "$DOCK_PROC"
    sleep 1
    setsid $DOCK_CMD >/dev/null 2>&1 </dev/null &
  fi
}

case "$THEME" in
  macos-light)
    gs gtk-theme "WhiteSur-Light"
    gs color-scheme "prefer-light"
    gs cursor-theme "macos-tahoe-cursor"
    gs cursor-size 32
    gs font-name "SF Pro Text 11"
    gs document-font-name "SF Pro Text 11"
    apply_dock_style light
    ;;
  macos-dark)
    gs gtk-theme "WhiteSur-Dark"
    gs color-scheme "prefer-dark"
    gs cursor-theme "macos-tahoe-cursor"
    gs cursor-size 32
    gs font-name "SF Pro Text 11"
    gs document-font-name "SF Pro Text 11"
    apply_dock_style dark
    ;;
  ironman)
    # Adwaita-dark rather than WhiteSur: the Mac chrome fights the red plate,
    # and Adwaita's neutral dark greys let the gold accent do the talking.
    # The icon set comes from ironman/icons.theme, which Omarchy applies.
    gs gtk-theme "Adwaita-dark"
    gs color-scheme "prefer-dark"
    # Keep the Tahoe pointer — it is a well-drawn cursor, and nothing in the
    # AUR ships an Iron Man one worth the dependency.
    gs cursor-theme "macos-tahoe-cursor"
    gs cursor-size 32
    gs font-name "SF Pro Text 11"
    gs document-font-name "SF Pro Text 11"
    apply_dock_style dark
    ;;
  *)
    # Any other theme, stock or third-party: Adwaita matched to the theme's own
    # light/dark mode, and the dock restyled to match. Without this a dark theme
    # like tokyo-night got light Adwaita apps and whichever dock style happened
    # to be left over.
    if [ "$(theme_mode "$THEME")" = "light" ]; then
      gs gtk-theme "Adwaita"
      gs color-scheme "prefer-light"
      apply_dock_style light
    else
      gs gtk-theme "Adwaita-dark"
      gs color-scheme "prefer-dark"
      apply_dock_style dark
    fi
    gs cursor-theme "macos-tahoe-cursor"
    gs cursor-size 32
    gs font-name "SF Pro Text 11"
    gs document-font-name "SF Pro Text 11"
    ;;
esac
